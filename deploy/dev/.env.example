# This file configures Compose only. Copy it to deploy/dev/.env on the VPS.
# Runtime configuration remains in deploy/env/*.env and must never be uploaded by CI.
DEPLOY_BIND_ADDRESS=127.0.0.1
WEB_IMAGE=ghcr.io/sirobaby/learningplatform-web@sha256:replace-with-a-real-64-character-image-digest
API_IMAGE=ghcr.io/sirobaby/learningplatform-api@sha256:replace-with-a-real-64-character-image-digest
WORKER_IMAGE=ghcr.io/sirobaby/learningplatform-api@sha256:replace-with-a-real-64-character-image-digest
