# App
NODE_ENV=development
PORT=3000

# Swagger is disabled by default. When enabled, both credentials are required.
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# LLM. Local development defaults to the deterministic offline fake.
# OPENAI_* secrets belong only to the worker deployment, never the HTTP API process.
# AI_LLM_PROVIDER=openai means one operator-managed OpenAI-compatible endpoint.
AI_LLM_PROVIDER=fake
# Local/development custom-provider credentials use a base64-encoded 32-byte key.
# Production must replace local mode with the configured KMS adapter.
AI_CREDENTIAL_ENCRYPTION_MODE=local
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_FREE_CREDITS=10000
AI_PAID_CREDITS=100000
AI_PLATFORM_MODEL_ID=platform-default
AI_PLATFORM_MODEL_LABEL=Fast platform model
AI_PLATFORM_INPUT_CREDITS_PER_TOKEN=1
AI_PLATFORM_OUTPUT_CREDITS_PER_TOKEN=2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSPORT=responses
OPENAI_STRUCTURED_OUTPUT_MODE=json-schema-strict
OPENAI_CAPABILITY_VERSION=responses-json-schema-strict-v1
OPENAI_REQUEST_TIMEOUT_MS=60000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=learning
DB_PASSWORD=learning
DB_NAME=learning

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
# Presigned URL hết hạn (giây)
MINIO_PRESIGN_EXPIRY=300

# Worker deployment only. Tune from observed queue depth and processing latency.
WORKER_POLL_INTERVAL_MS=1000
WORKER_ERROR_BACKOFF_MS=5000
WORKER_OUTBOX_BATCH_SIZE=100
WORKER_JOB_BATCH_SIZE=10
WORKER_STUCK_JOB_BATCH_SIZE=100
WORKER_STUCK_JOB_TIMEOUT_MS=300000
WORKER_MAX_EXTRACTABLE_OBJECT_BYTES=20971520
WORKER_CHUNK_INSERT_BATCH_SIZE=500
WORKER_CHUNK_MAX_CHARS=1500
WORKER_CHUNK_TARGET_CHARS=1200
WORKER_CHUNK_OVERLAP_CHARS=150
WORKER_MAX_CHUNKS_PER_DOCUMENT=20000
WORKER_MAX_CHUNK_TOTAL_CHARS=24000000
