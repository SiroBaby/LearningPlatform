{
  "name": "ai-learning-platform",
  "version": "0.0.1",
  "description": "AI Learning Platform - Phase 0 monolith slice",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "ts-node src/worker.ts",
    "migration:new": "node scripts/new-migration.js",
    "migration:run": "ts-node -T src/database/migrate.ts up",
    "migration:revert": "ts-node -T src/database/migrate.ts down",
    "migration:status": "ts-node -T src/database/migrate.ts status"
  },
  "dependencies": {
    "@automapper/classes": "8.8.1",
    "@automapper/core": "8.8.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/testing": "11.1.28",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "16.6.1",
    "minio": "8.0.7",
    "pdfjs-dist": "5.4.296",
    "pg": "8.21.0",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2",
    "typeorm": "0.3.30",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@testcontainers/postgresql": "12.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.20",
    "@types/pg": "8.20.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
