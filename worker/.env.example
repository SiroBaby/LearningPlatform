# Copy this file to worker/.env (ignored) and replace every CHANGE_ME value.
# This is the canonical worker environment template for all worker commands.

NODE_ENV=development

# Health endpoint. Keep this local-only address for one-machine development.
AI_WORKER_HEALTH_ADDRESS=127.0.0.1:3403
# Bounded durable-queue consumer lifecycle. A job timeout stays below the
# PostgreSQL lease window so expired leases remain the crash/replay boundary.
AI_WORKER_CONCURRENCY=2
AI_WORKER_JOB_TIMEOUT_MS=600000
AI_WORKER_POLL_INTERVAL_MS=1000
AI_WORKER_SHUTDOWN_TIMEOUT_MS=30000

# PostgreSQL. Required by normal worker startup and configuration loading.
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME

# Object storage. OBJECT_STORAGE_ENDPOINT is host-only; OBJECT_STORAGE_PORT
# carries the TCP port. Do not include a scheme, port, path, query, or fragment.
# Preflight does not connect to storage, but these fields are required by the
# shared worker configuration. These values are harmless local placeholders;
# replace them for a real worker start.
OBJECT_STORAGE_ENDPOINT=localhost
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_ACCESS_KEY=local-only-placeholder
OBJECT_STORAGE_SECRET_KEY=local-only-placeholder
OBJECT_STORAGE_BUCKET=local-only-placeholder
AI_WORKER_ALLOW_INSECURE_LOCAL_ENDPOINTS=true

# Provider contract. AI_LLM_PROVIDER is fake or openai-compatible.
# Use openai-compatible for a real preflight; all OPENAI_* values below then
# become required. The URL must be an absolute HTTP(S) URL without credentials,
# query parameters, or a fragment.
AI_LLM_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://provider.example.invalid/v1
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=CHANGE_ME

# Allowed coherent pairs:
#   chat-completions-json-v1 + chat-completions
#   responses-json-v1 + responses
OPENAI_CAPABILITY_VERSION=chat-completions-json-v1
OPENAI_TRANSPORT=chat-completions
OPENAI_STRUCTURED_OUTPUT_MODE=json-object
OPENAI_REQUEST_TIMEOUT_MS=60000

# Optional for normal startup; preflight exits before reading migrations.
AI_WORKER_MIGRATIONS_DIR=CHANGE_ME
