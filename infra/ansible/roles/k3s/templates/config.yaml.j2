# This file is managed by Ansible. K3s packaged Traefik and ServiceLB remain
# enabled because neither component appears in the disable list.
write-kubeconfig-mode: "{{ k3s_write_kubeconfig_mode }}"
disable: []
kube-proxy-arg:
  - nodeport-addresses=127.0.0.0/8
kubelet-arg:
  - image-gc-high-threshold={{ k3s_image_gc_high_threshold_percent }}
  - image-gc-low-threshold={{ k3s_image_gc_low_threshold_percent }}
  - image-maximum-gc-age={{ k3s_image_maximum_gc_age }}
