apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: {{ alertmanager_config_secret_name }}
  namespace: {{ observability_namespace }}
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: SecretStore
    name: aws-parameter-store
  target:
    name: {{ alertmanager_config_secret_name }}
    creationPolicy: Owner
    template:
      engineVersion: v2
      mergePolicy: Replace
      data:
        alertmanager.yaml: |
          global:
            resolve_timeout: 5m
          route:
            receiver: telegram
            group_by: [alertname, namespace, severity]
            group_wait: 30s
            group_interval: 5m
            repeat_interval: 4h
          receivers:
            - name: telegram
              telegram_configs:
                - bot_token: '{{ '{{ .telegram_bot_token }}' }}'
                  chat_id: {{ '{{ .telegram_chat_id }}' }}
                  send_resolved: true
  data:
    - secretKey: telegram_bot_token
      remoteRef:
        key: {{ ssm_parameter_keys.alertmanager_telegram_bot_token }}
    - secretKey: telegram_chat_id
      remoteRef:
        key: {{ ssm_parameter_keys.alertmanager_telegram_chat_id }}
