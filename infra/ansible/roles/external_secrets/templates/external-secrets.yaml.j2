apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: aws-parameter-store
  namespace: {{ learning_platform_namespace }}
spec:
  provider:
    aws:
      service: ParameterStore
      region: {{ aws_region }}
      auth:
        secretRef:
          accessKeyIDSecretRef:
            name: {{ aws_credentials_secret_name }}
            key: access-key-id
          secretAccessKeySecretRef:
            name: {{ aws_credentials_secret_name }}
            key: secret-access-key
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: learning-platform-api-runtime
  namespace: {{ learning_platform_namespace }}
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: SecretStore
    name: aws-parameter-store
  target:
    name: learning-platform-api-runtime
    creationPolicy: Owner
  data:
{% for secret_key, remote_key in {
  'DB_HOST': ssm_parameter_keys.db_host,
  'DB_PORT': ssm_parameter_keys.db_port,
  'DB_USER': ssm_parameter_keys.db_user,
  'DB_PASSWORD': ssm_parameter_keys.db_password,
  'DB_NAME': ssm_parameter_keys.db_name,
  'DB_SSL_MODE': ssm_parameter_keys.db_ssl_mode,
  'DB_SSL_CA': ssm_parameter_keys.db_ssl_ca,
  'GOOGLE_CLIENT_ID': ssm_parameter_keys.google_client_id,
  'GOOGLE_CLIENT_SECRET': ssm_parameter_keys.google_client_secret,
  'GOOGLE_REDIRECT_URI': ssm_parameter_keys.google_redirect_uri,
  'AUTH_OAUTH_ENCRYPTION_KEY': ssm_parameter_keys.auth_oauth_encryption_key,
  'OBJECT_STORAGE_ENDPOINT': ssm_parameter_keys.object_storage_endpoint,
  'OBJECT_STORAGE_PORT': ssm_parameter_keys.object_storage_port,
  'OBJECT_STORAGE_REGION': ssm_parameter_keys.object_storage_region,
  'OBJECT_STORAGE_USE_SSL': ssm_parameter_keys.object_storage_use_ssl,
  'OBJECT_STORAGE_ACCESS_KEY': ssm_parameter_keys.object_storage_access_key,
  'OBJECT_STORAGE_SECRET_KEY': ssm_parameter_keys.object_storage_secret_key,
  'OBJECT_STORAGE_BUCKET': ssm_parameter_keys.object_storage_bucket,
  'AI_CREDENTIAL_ENCRYPTION_KEY': ssm_parameter_keys.ai_credential_encryption_key
}.items() %}
    - secretKey: {{ secret_key }}
      remoteRef:
        key: {{ remote_key }}
{% endfor %}
---
