            - name: SWAGGER_ENABLED
              value: 'true'
            - name: SWAGGER_USERNAME
              valueFrom:
                secretKeyRef:
                  name: learning-platform-swagger-runtime
                  key: SWAGGER_USERNAME
            - name: SWAGGER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: learning-platform-swagger-runtime
                  key: SWAGGER_PASSWORD
{% for key in ['DB_HOST', 'DB_PORT', 'DB_USER', 'DB_PASSWORD', 'DB_NAME', 'DB_SSL_MODE', 'DB_SSL_CA', 'GOOGLE_CLIENT_ID', 'GOOGLE_CLIENT_SECRET', 'GOOGLE_REDIRECT_URI', 'AUTH_OAUTH_ENCRYPTION_KEY', 'AUTH_ADMIN_GOOGLE_SUBS', 'AUTH_EXTERNAL_APPROVAL_PUBLIC_KEY', 'AUTH_EXTERNAL_APPROVAL_ISSUER', 'AUTH_EXTERNAL_APPROVAL_AUDIENCE', 'OBJECT_STORAGE_ENDPOINT', 'OBJECT_STORAGE_PORT', 'OBJECT_STORAGE_REGION', 'OBJECT_STORAGE_USE_SSL', 'OBJECT_STORAGE_ACCESS_KEY', 'OBJECT_STORAGE_SECRET_KEY', 'OBJECT_STORAGE_BUCKET', 'AI_CREDENTIAL_ENCRYPTION_KEY'] %}
