{% if 'web' in deployment_targets %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: web
  template:
    metadata:
      annotations:
        learning-platform.io/rollout-revision: recreate-rollout-recovery-v1
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: web
    spec:
      serviceAccountName: web-bff
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      imagePullSecrets:
        - name: {{ ghcr_pull_secret_name }}
      containers:
        - name: web
          image: {{ web_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: PORT
              value: '3000'
            - name: HOSTNAME
              value: 0.0.0.0
            - name: NODE_ENV
              value: production
            - name: AUTH_INTERNAL_API_BASE_URL
              value: https://api-internal:3443
            - name: AUTH_INTERNAL_MTLS_CA_PATH
              value: /var/run/identity/web-bff/ca.crt
            - name: AUTH_INTERNAL_MTLS_CERT_PATH
              value: /var/run/identity/web-bff/tls.crt
            - name: AUTH_INTERNAL_MTLS_KEY_PATH
              value: /var/run/identity/web-bff/tls.key
            - name: WEB_PUBLIC_ORIGIN
              value: https://{{ web_public_host }}
            - name: MEDIA_UPLOADS_ENABLED
              value: '{{ api_media_enabled | default(false) | bool | ternary("true", "false") }}'
          volumeMounts:
            - name: web-bff-tls
              mountPath: /var/run/identity/web-bff
              readOnly: true
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ web_resources | to_json }}
      volumes:
        - name: web-bff-tls
          secret:
            secretName: web-bff-tls
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: web
  ports:
    - name: http
      port: 3000
      targetPort: http
{% endif %}
{% if 'api' in deployment_targets %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: api
  template:
    metadata:
      annotations:
        learning-platform.io/rollout-revision: recreate-rollout-recovery-v1
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: api
    spec:
      serviceAccountName: api-internal
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      imagePullSecrets:
        - name: {{ ghcr_pull_secret_name }}
      containers:
        - name: api
          image: {{ api_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
            - name: internal-https
              containerPort: 3443
          env:
            - name: NODE_ENV
              value: production
            - name: OBJECT_STORAGE_MEDIA_ENABLED
              value: '{{ api_media_enabled | default(false) | bool | ternary("true", "false") }}'
            - name: PORT
              value: '3000'
            - name: INTERNAL_MTLS_PORT
              value: '3443'
            - name: INTERNAL_MTLS_CERT_PATH
              value: /var/run/identity/api-internal/tls.crt
            - name: INTERNAL_MTLS_KEY_PATH
              value: /var/run/identity/api-internal/tls.key
            - name: INTERNAL_MTLS_CA_PATH
              value: /var/run/identity/api-internal/ca.crt
            - name: INTERNAL_MTLS_EXPECTED_CLIENT_SPIFFE_URI
              value: spiffe://learning-platform.local/ns/{{ learning_platform_namespace }}/sa/go-worker
            - name: INTERNAL_MTLS_EXPECTED_WEB_BFF_SPIFFE_URI
              value: spiffe://learning-platform.local/ns/{{ learning_platform_namespace }}/sa/web-bff
            - name: SWAGGER_ENABLED
              value: 'true'
            - name: SWAGGER_USERNAME
              valueFrom:
                secretKeyRef:
                  name: learning-platform-swagger-runtime
                  key: SWAGGER_USERNAME
            - name: SWAGGER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: learning-platform-swagger-runtime
                  key: SWAGGER_PASSWORD
{% for key in ['DB_HOST', 'DB_PORT', 'DB_USER', 'DB_PASSWORD', 'DB_NAME', 'DB_SSL_MODE', 'DB_SSL_CA', 'GOOGLE_CLIENT_ID', 'GOOGLE_CLIENT_SECRET', 'GOOGLE_REDIRECT_URI', 'AUTH_OAUTH_ENCRYPTION_KEY', 'AUTH_ADMIN_GOOGLE_SUBS', 'AUTH_EXTERNAL_APPROVAL_PUBLIC_KEY', 'AUTH_EXTERNAL_APPROVAL_ISSUER', 'AUTH_EXTERNAL_APPROVAL_AUDIENCE', 'OBJECT_STORAGE_ENDPOINT', 'OBJECT_STORAGE_PORT', 'OBJECT_STORAGE_REGION', 'OBJECT_STORAGE_USE_SSL', 'OBJECT_STORAGE_ACCESS_KEY', 'OBJECT_STORAGE_SECRET_KEY', 'OBJECT_STORAGE_BUCKET', 'AI_CREDENTIAL_ENCRYPTION_KEY'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-api-runtime
                  key: {{ key }}
{% endfor %}
{% if object_storage_egress_proxy_enabled | default(false) | bool %}
            # Non-secret in-cluster proxy route; a manifest literal, not SSM.
            - name: OBJECT_STORAGE_EGRESS_PROXY_URL
              value: {{ media_probe_worker_proxy_url | quote }}
{% endif %}
{% if api_media_enabled | default(false) | bool %}
{% for key in ['OBJECT_STORAGE_MEDIA_BUCKET', 'OBJECT_STORAGE_API_MEDIA_ACCESS_KEY', 'OBJECT_STORAGE_API_MEDIA_SECRET_KEY'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-api-runtime
                  key: {{ key }}
{% endfor %}
{% endif %}
          volumeMounts:
            - name: api-internal-tls
              mountPath: /var/run/identity/api-internal
              readOnly: true
          readinessProbe:
            httpGet:
              path: /api/v1/health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /api/v1/health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ api_resources | to_json }}
      volumes:
        - name: api-internal-tls
          secret:
            secretName: api-internal-tls
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: api
  ports:
    - name: http
      port: 3000
      targetPort: http
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: api-internal
  namespace: {{ learning_platform_namespace }}
automountServiceAccountToken: false
---
apiVersion: v1
kind: Service
metadata:
  name: api-internal
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: api
  ports:
    - name: https
      port: 3443
      targetPort: internal-https
