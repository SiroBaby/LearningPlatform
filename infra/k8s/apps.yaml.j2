{% if 'worker' in deployment_targets %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: worker
  template:
    metadata:
      annotations:
        learning-platform.io/rollout-revision: recreate-rollout-recovery-v1
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: worker
    spec:
      serviceAccountName: go-worker
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      imagePullSecrets:
        - name: {{ ghcr_pull_secret_name }}
      containers:
        - name: worker
          image: {{ worker_image }}
          imagePullPolicy: IfNotPresent
          command: ['node', 'dist/worker.js']
          ports:
            - name: health
              containerPort: 3403
          env:
            - name: NODE_ENV
              value: production
            - name: WORKER_HEALTH_HOST
              value: 0.0.0.0
            - name: WORKER_HEALTH_PORT
              value: '3403'
            - name: WORKER_EXECUTION_MODE
              value: relay-only
            - name: WORKER_QUIZ_GENERATION_CONCURRENCY
              value: '8'
{% for key in ['DB_HOST', 'DB_PORT', 'DB_USER', 'DB_PASSWORD', 'DB_NAME', 'DB_SSL_MODE', 'DB_SSL_CA', 'OBJECT_STORAGE_ENDPOINT', 'OBJECT_STORAGE_PORT', 'OBJECT_STORAGE_REGION', 'OBJECT_STORAGE_USE_SSL', 'OBJECT_STORAGE_ACCESS_KEY', 'OBJECT_STORAGE_SECRET_KEY', 'OBJECT_STORAGE_BUCKET', 'AI_CREDENTIAL_ENCRYPTION_KEY'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-worker-runtime
                  key: {{ key }}
{% endfor %}
          volumeMounts:
            - name: go-worker-tls
              mountPath: /var/run/identity/go-worker
              readOnly: true
          readinessProbe:
            httpGet:
              path: /health
              port: health
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health
              port: health
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ worker_resources | to_json }}
        - name: go-worker
          image: {{ go_worker_image | default(worker_image) }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: go-health
              containerPort: 3404
          env:
            - name: NODE_ENV
              value: production
            - name: AI_LLM_PROVIDER
              value: openai-compatible
            - name: OPENAI_CAPABILITY_VERSION
              value: chat-completions-json-v1
            - name: OPENAI_STRUCTURED_OUTPUT_MODE
              value: json-object
            - name: OPENAI_TRANSPORT
              value: chat-completions
            - name: OPENAI_REQUEST_TIMEOUT_MS
              value: "60000"
            - name: AI_WORKER_HEALTH_ADDRESS
              value: 0.0.0.0:3404
            - name: AI_WORKER_MIGRATIONS_DIR
              value: /app/migrations
            - name: AI_WORKER_CONCURRENCY
              value: '2'
            - name: AI_WORKER_JOB_TIMEOUT_MS
              value: '600000'
            - name: AI_WORKER_POLL_INTERVAL_MS
              value: '1000'
            - name: AI_WORKER_SHUTDOWN_TIMEOUT_MS
              value: '30000'
{% for key in ['DB_HOST', 'DB_PORT', 'DB_USER', 'DB_PASSWORD', 'DB_NAME', 'DB_SSL_MODE', 'DB_SSL_CA'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-api-runtime
                  key: {{ key }}
{% endfor %}
{% for key in ['OBJECT_STORAGE_ENDPOINT', 'OBJECT_STORAGE_PORT', 'OBJECT_STORAGE_USE_SSL', 'OBJECT_STORAGE_ACCESS_KEY', 'OBJECT_STORAGE_SECRET_KEY', 'OBJECT_STORAGE_BUCKET', 'OPENAI_BASE_URL', 'OPENAI_API_KEY', 'OPENAI_MODEL'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-go-worker-runtime
                  key: {{ key }}
{% endfor %}
{% if media_probe_worker_enabled | default(false) | bool %}
{% for key in ['OBJECT_STORAGE_MEDIA_BUCKET', 'OBJECT_STORAGE_FULL_PIPELINE_MEDIA_ACCESS_KEY', 'OBJECT_STORAGE_FULL_PIPELINE_MEDIA_SECRET_KEY'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-go-worker-runtime
                  key: {{ key }}
{% endfor %}
            # Media reads on VPS must use the in-cluster allowlisted proxy.
            - name: OBJECT_STORAGE_EGRESS_PROXY_URL
              value: {{ media_probe_worker_proxy_url | quote }}
{% endif %}
{% if object_storage_egress_proxy_enabled | default(false) | bool %}
{% if not media_probe_worker_enabled | default(false) | bool %}
            - name: OBJECT_STORAGE_EGRESS_PROXY_URL
              value: {{ media_probe_worker_proxy_url | quote }}
{% endif %}
{% endif %}
          readinessProbe:
