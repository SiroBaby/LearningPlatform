            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ go_worker_resources | to_json }}
      volumes:
        - name: go-worker-tls
          secret:
            secretName: go-worker-tls
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: worker
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
