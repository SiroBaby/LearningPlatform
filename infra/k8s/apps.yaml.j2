---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: worker
  template:
    metadata:
      annotations:
        learning-platform.io/rollout-revision: recreate-rollout-recovery-v1
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: worker
    spec:
      serviceAccountName: go-worker
      securityContext:
        runAsNonRoot: true
