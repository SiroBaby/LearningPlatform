{% if media_egress_proxy_enabled | default(false) | bool %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: media-egress-proxy-config
  namespace: {{ learning_platform_namespace }}
data:
  squid.conf: |
    # This proxy is deliberately limited to HTTPS CONNECT for the regional S3 endpoint.
    visible_hostname media-egress-proxy
    http_port 0.0.0.0:3128
    acl proxy_localhost src 127.0.0.1/32
    acl CONNECT method CONNECT
    acl SSL_ports port 443
    acl s3_endpoint dstdomain .s3.ap-southeast-1.amazonaws.com
    http_access allow proxy_localhost manager
    http_access deny manager
    http_access allow CONNECT s3_endpoint SSL_ports
    http_access deny all
    connect_timeout 30 seconds
    request_timeout 30 seconds
    read_timeout 5 minutes
    cache deny all
    access_log none
    cache_store_log none
    cache_log none
    pid_filename /tmp/squid.pid
    coredump_dir /var/spool/squid
    shutdown_lifetime 1 second
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: media-egress-proxy
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: media-egress-proxy
  template:
    metadata:
      annotations:
        # ConfigMap is mounted through subPath, so change this revision with every proxy config change.
        learning-platform.io/rollout-revision: media-egress-proxy-v2
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: media-egress-proxy
    spec:
      serviceAccountName: media-egress-proxy
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 13
        runAsGroup: 13
        fsGroup: 13
        seccompProfile:
          type: RuntimeDefault
      imagePullSecrets:
        - name: {{ ghcr_pull_secret_name }}
      containers:
        - name: media-egress-proxy
          image: ubuntu/squid@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029
          imagePullPolicy: IfNotPresent
          command:
            - /usr/sbin/squid
          args:
            - -f
            - /etc/squid/squid.conf
            - -NYC
          ports:
            - name: proxy
              containerPort: 3128
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          readinessProbe:
            tcpSocket:
              port: proxy
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            tcpSocket:
              port: proxy
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests:
              cpu: 25m
              memory: 64Mi
              ephemeral-storage: 80Mi
            limits:
              cpu: 250m
              memory: 256Mi
              ephemeral-storage: 80Mi
          volumeMounts:
            - name: squid-config
              mountPath: /etc/squid/squid.conf
              subPath: squid.conf
              readOnly: true
            - name: squid-cache
              mountPath: /var/spool/squid
            - name: squid-logs
              mountPath: /var/log/squid
            - name: squid-runtime
              mountPath: /tmp
      volumes:
        - name: squid-config
          configMap:
            name: media-egress-proxy-config
            defaultMode: 0444
        - name: squid-cache
          emptyDir:
            sizeLimit: 64Mi
        - name: squid-logs
          emptyDir:
            sizeLimit: 16Mi
        - name: squid-runtime
          emptyDir:
            sizeLimit: 16Mi
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: media-egress-proxy
  namespace: {{ learning_platform_namespace }}
automountServiceAccountToken: false
---
apiVersion: v1
kind: Service
metadata:
  name: media-egress-proxy
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: media-egress-proxy
  ports:
    - name: proxy
      port: 3128
      targetPort: proxy
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: media-egress-proxy-ingress
  namespace: {{ learning_platform_namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: media-egress-proxy
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: learning-platform
              app.kubernetes.io/component: api
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: learning-platform
              app.kubernetes.io/component: worker
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: learning-platform
              app.kubernetes.io/component: media-probe-worker
      ports:
        - protocol: TCP
          port: 3128
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: media-egress-proxy-egress
  namespace: {{ learning_platform_namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: media-egress-proxy
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock:
            cidr: {{ media_probe_worker_dns_ip }}/32
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    # NetworkPolicy cannot safely encode the S3 hostname. Squid's dstdomain
    # ACL is the destination allowlist; this rule only permits HTTPS egress.
    - ports:
        - protocol: TCP
          port: 443
{% endif %}
{% if 'web' in deployment_targets or 'api' in deployment_targets %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: learning-platform
  namespace: {{ learning_platform_namespace }}
{% if ingress_tls_secret_name | length > 0 %}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: 'true'
{% endif %}
spec:
  ingressClassName: traefik
{% if ingress_tls_secret_name | length > 0 %}
  tls:
    - hosts:
        - {{ web_public_host }}
        - {{ api_public_host }}
      secretName: {{ ingress_tls_secret_name }}
{% endif %}
  rules:
    - host: {{ api_public_host }}
      http:
        paths:
          - path: /api/v1
            pathType: Prefix
            backend:
              service:
                name: api
                port:
                  name: http
    - host: {{ web_public_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: web
                port:
                  name: http
