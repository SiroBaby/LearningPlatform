{% if 'web' in deployment_targets %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: web
  template:
    metadata:
      annotations:
        learning-platform.io/rollout-revision: recreate-rollout-recovery-v1
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: web
    spec:
      serviceAccountName: web-bff
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      imagePullSecrets:
        - name: {{ ghcr_pull_secret_name }}
      containers:
        - name: web
          image: {{ web_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: PORT
              value: '3000'
            - name: HOSTNAME
              value: 0.0.0.0
            - name: NODE_ENV
              value: production
            - name: AUTH_INTERNAL_API_BASE_URL
              value: https://api-internal:3443
            - name: AUTH_INTERNAL_MTLS_CA_PATH
              value: /var/run/identity/web-bff/ca.crt
            - name: AUTH_INTERNAL_MTLS_CERT_PATH
              value: /var/run/identity/web-bff/tls.crt
            - name: AUTH_INTERNAL_MTLS_KEY_PATH
              value: /var/run/identity/web-bff/tls.key
            - name: WEB_PUBLIC_ORIGIN
              value: https://{{ web_public_host }}
            - name: MEDIA_UPLOADS_ENABLED
              value: '{{ api_media_enabled | default(false) | bool | ternary("true", "false") }}'
          volumeMounts:
            - name: web-bff-tls
              mountPath: /var/run/identity/web-bff
              readOnly: true
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ web_resources | to_json }}
      volumes:
        - name: web-bff-tls
          secret:
            secretName: web-bff-tls
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: web
  ports:
    - name: http
      port: 3000
      targetPort: http
{% endif %}
