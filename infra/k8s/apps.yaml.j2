{% if 'web' in deployment_targets %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: web
  template:
    metadata:
      annotations:
        learning-platform.io/rollout-revision: recreate-rollout-recovery-v1
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: web
    spec:
      imagePullSecrets:
        - name: {{ ghcr_pull_secret_name }}
      containers:
        - name: web
          image: {{ web_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: PORT
              value: '3000'
            - name: HOSTNAME
              value: 0.0.0.0
            - name: PHASE0_API_BASE_URL
              value: {{ phase0_api_base_url }}
            - name: PHASE0_DEV_OWNER_ID
              value: {{ phase0_dev_owner_id }}
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ web_resources | to_json }}
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: web
  ports:
    - name: http
      port: 3000
      targetPort: http
{% endif %}
{% if 'api' in deployment_targets %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: api
  template:
    metadata:
      annotations:
        learning-platform.io/rollout-revision: recreate-rollout-recovery-v1
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: api
    spec:
      serviceAccountName: api-internal
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      imagePullSecrets:
        - name: {{ ghcr_pull_secret_name }}
      containers:
        - name: api
          image: {{ api_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
            - name: internal-https
              containerPort: 3443
          env:
            - name: NODE_ENV
              value: production
            - name: PORT
              value: '3000'
            - name: INTERNAL_MTLS_PORT
              value: '3443'
            - name: INTERNAL_MTLS_CERT_PATH
              value: /var/run/identity/api-internal/tls.crt
            - name: INTERNAL_MTLS_KEY_PATH
              value: /var/run/identity/api-internal/tls.key
            - name: INTERNAL_MTLS_CA_PATH
              value: /var/run/identity/api-internal/ca.crt
            - name: INTERNAL_MTLS_EXPECTED_CLIENT_SPIFFE_URI
              value: spiffe://learning-platform.local/ns/{{ learning_platform_namespace }}/sa/go-worker
            - name: SWAGGER_ENABLED
              value: 'true'
            - name: SWAGGER_USERNAME
              valueFrom:
                secretKeyRef:
                  name: learning-platform-swagger-runtime
                  key: SWAGGER_USERNAME
            - name: SWAGGER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: learning-platform-swagger-runtime
                  key: SWAGGER_PASSWORD
{% for key in ['DB_HOST', 'DB_PORT', 'DB_USER', 'DB_PASSWORD', 'DB_NAME', 'DB_SSL_MODE', 'DB_SSL_CA', 'OBJECT_STORAGE_ENDPOINT', 'OBJECT_STORAGE_PORT', 'OBJECT_STORAGE_REGION', 'OBJECT_STORAGE_USE_SSL', 'OBJECT_STORAGE_ACCESS_KEY', 'OBJECT_STORAGE_SECRET_KEY', 'OBJECT_STORAGE_BUCKET', 'AI_CREDENTIAL_ENCRYPTION_KEY'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-api-runtime
                  key: {{ key }}
{% endfor %}
          volumeMounts:
            - name: api-internal-tls
              mountPath: /var/run/identity/api-internal
              readOnly: true
          readinessProbe:
            httpGet:
              path: /api/v1/health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /api/v1/health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ api_resources | to_json }}
      volumes:
        - name: api-internal-tls
          secret:
            secretName: api-internal-tls
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: api
  ports:
    - name: http
      port: 3000
      targetPort: http
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: api-internal
  namespace: {{ learning_platform_namespace }}
automountServiceAccountToken: false
---
apiVersion: v1
kind: Service
metadata:
  name: api-internal
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: api
  ports:
    - name: https
      port: 3443
      targetPort: internal-https
{% endif %}
{% if 'worker' in deployment_targets %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  namespace: {{ learning_platform_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: learning-platform
      app.kubernetes.io/component: worker
  template:
    metadata:
      annotations:
        learning-platform.io/rollout-revision: recreate-rollout-recovery-v1
      labels:
        app.kubernetes.io/name: learning-platform
        app.kubernetes.io/component: worker
    spec:
      serviceAccountName: go-worker
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      imagePullSecrets:
        - name: {{ ghcr_pull_secret_name }}
      containers:
        - name: worker
          image: {{ worker_image }}
          imagePullPolicy: IfNotPresent
          command: ['node', 'dist/worker.js']
          ports:
            - name: health
              containerPort: 3403
          env:
            - name: NODE_ENV
              value: production
            - name: WORKER_HEALTH_HOST
              value: 0.0.0.0
            - name: WORKER_HEALTH_PORT
              value: '3403'
            - name: WORKER_QUIZ_GENERATION_CONCURRENCY
              value: '8'
{% for key in ['DB_HOST', 'DB_PORT', 'DB_USER', 'DB_PASSWORD', 'DB_NAME', 'DB_SSL_MODE', 'DB_SSL_CA', 'OBJECT_STORAGE_ENDPOINT', 'OBJECT_STORAGE_PORT', 'OBJECT_STORAGE_REGION', 'OBJECT_STORAGE_USE_SSL', 'OBJECT_STORAGE_ACCESS_KEY', 'OBJECT_STORAGE_SECRET_KEY', 'OBJECT_STORAGE_BUCKET', 'AI_CREDENTIAL_ENCRYPTION_KEY'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-worker-runtime
                  key: {{ key }}
{% endfor %}
          volumeMounts:
            - name: go-worker-tls
              mountPath: /var/run/identity/go-worker
              readOnly: true
          readinessProbe:
            httpGet:
              path: /health
              port: health
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health
              port: health
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ worker_resources | to_json }}
        - name: go-worker
          image: {{ go_worker_image | default(worker_image) }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: go-health
              containerPort: 3404
          env:
            - name: NODE_ENV
              value: production
            - name: AI_LLM_PROVIDER
              value: openai-compatible
            - name: OPENAI_CAPABILITY_VERSION
              value: chat-completions-json-v1
            - name: OPENAI_STRUCTURED_OUTPUT_MODE
              value: json-object
            - name: OPENAI_TRANSPORT
              value: chat-completions
            - name: OPENAI_REQUEST_TIMEOUT_MS
              value: "60000"
            - name: AI_WORKER_HEALTH_ADDRESS
              value: 0.0.0.0:3404
            - name: AI_WORKER_MIGRATIONS_DIR
              value: /app/migrations
{% for key in ['DB_HOST', 'DB_PORT', 'DB_USER', 'DB_PASSWORD', 'DB_NAME'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-api-runtime
                  key: {{ key }}
{% endfor %}
{% for key in ['OBJECT_STORAGE_ENDPOINT', 'OBJECT_STORAGE_PORT', 'OBJECT_STORAGE_USE_SSL', 'OBJECT_STORAGE_ACCESS_KEY', 'OBJECT_STORAGE_SECRET_KEY', 'OBJECT_STORAGE_BUCKET', 'OPENAI_BASE_URL', 'OPENAI_API_KEY', 'OPENAI_MODEL'] %}
            - name: {{ key }}
              valueFrom:
                secretKeyRef:
                  name: learning-platform-go-worker-runtime
                  key: {{ key }}
{% endfor %}
          readinessProbe:
            httpGet:
              path: /readyz
              port: go-health
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /healthz
              port: go-health
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources: {{ worker_resources | to_json }}
      volumes:
        - name: go-worker-tls
          secret:
            secretName: go-worker-tls
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: worker
  namespace: {{ learning_platform_namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: learning-platform
    app.kubernetes.io/component: worker
  ports:
    - name: health
      port: 3403
      targetPort: health
{% endif %}
{% if 'web' in deployment_targets or 'api' in deployment_targets %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: learning-platform
  namespace: {{ learning_platform_namespace }}
{% if ingress_tls_secret_name | length > 0 %}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: 'true'
{% endif %}
spec:
  ingressClassName: traefik
{% if ingress_tls_secret_name | length > 0 %}
  tls:
    - hosts:
        - {{ web_public_host }}
        - {{ api_public_host }}
      secretName: {{ ingress_tls_secret_name }}
{% endif %}
  rules:
    - host: {{ api_public_host }}
      http:
        paths:
          - path: /api/v1
            pathType: Prefix
            backend:
              service:
                name: api
                port:
                  name: http
    - host: {{ web_public_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: web
                port:
                  name: http
{% endif %}
